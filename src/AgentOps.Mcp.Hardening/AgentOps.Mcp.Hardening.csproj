<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build configuration -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>AgentOps.Mcp.Hardening</AssemblyName>
    <RootNamespace>AgentOps.Mcp.Hardening</RootNamespace>

    <!-- Determinism / reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>AgentOps.Mcp.Hardening</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Pinusx AI, LLC</Authors>
    <Company>Pinusx AI, LLC</Company>
    <Copyright>Copyright (c) 2026 Pinusx AI, LLC</Copyright>
    <Description>Runaway prevention for Microsoft Agent Framework — bounded tool calls, recursion depth, and token budgets via Agent, Function, and Chat middleware layers. Prevents the unbounded loops, recursive subagent storms, and silent budget burns that turn a $5 chat into a $5,000 incident.</Description>
    <PackageTags>agentops;mcp;modelcontextprotocol;hardening;runaway-prevention;agent;maf;microsoft-agent-framework;middleware;dotnet;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pinusx-ai/agentops-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pinusx-ai/agentops-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Package validation (no baseline until 0.2.0-alpha establishes one) -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Symbol publishing -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- README packaged at root of nupkg -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core MAF + MEAI for the three middleware contracts -->
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.3.0,2.0.0)" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="[10.5.0,11.0.0)" />

    <!-- DI + Options + Logging abstractions (floating minor) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />

    <!-- SourceLink for symbol-package source navigation -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
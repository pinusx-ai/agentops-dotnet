    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentOps.Quickstart.Agent</AssemblyName>
    <RootNamespace>AgentOps.Quickstart.Agent</RootNamespace>
